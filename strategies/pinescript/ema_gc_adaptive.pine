//@version=6
// EMA Pullback Swing v1.2 — source of truth: strategies/DESIGN.md
// Stepped Chandelier risk: hard 3.5 ATR → BE at 1R → HH−3 ATR at 2R.
strategy("EMA Pullback Swing v1.2",
     overlay=true,
     initial_capital=20000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     commission_type=strategy.commission.percent,
     commission_value=0.1)

grp_trend = "Trend & Regime"
fast_len  = input.int(50, "Fast MA", group=grp_trend)
slow_len  = input.int(200, "Slow MA", group=grp_trend)
ma_type   = input.string("EMA", "MA Type", options=["EMA", "SMA"], group=grp_trend, tooltip="EMA = engine ema_pullback, SMA = engine sma50_reclaim")

grp_risk          = "Stepped Chandelier Risk"
atr_len           = input.int(14, "ATR Length", group=grp_risk)
atr_base_mult     = input.float(3.5, "Initial ATR Stop Mult", group=grp_risk, step=0.1)
be_r              = input.float(1.0, "Breakeven at R", group=grp_risk, step=0.1)
trail_r           = input.float(2.0, "Chandelier from R", group=grp_risk, step=0.1)
chandelier_mult   = input.float(3.0, "Chandelier ATR Mult", group=grp_risk, step=0.1)
risk_per_t        = input.float(1.5, "Risk % Per Trade", group=grp_risk)

ema50  = ma_type == "EMA" ? ta.ema(close, fast_len) : ta.sma(close, fast_len)
ema200 = ma_type == "EMA" ? ta.ema(close, slow_len) : ta.sma(close, slow_len)
atr    = ta.atr(atr_len)

bull_regime  = ema50 > ema200
regime_break = ta.crossunder(ema50, ema200)
reclaim = ta.crossover(close, ema50)
long_trigger = bull_regime and reclaim

var float entry_price  = na
var float trail_price  = na
var float initial_risk = na
var float hh_since_entry = na

if strategy.position_size > 0
    if na(entry_price)
        entry_price  := strategy.position_avg_price
        initial_risk := atr * atr_base_mult
        trail_price  := entry_price - initial_risk
        hh_since_entry := high

    hh_since_entry := math.max(hh_since_entry, high)
    unrealized_r = (close - entry_price) / (initial_risk > 0 ? initial_risk : 1.0)

    // Stepped: no close-ratchet while R < be_r; BE floor; then Chandelier.
    float candidate = trail_price
    if unrealized_r >= trail_r
        candidate := math.max(entry_price, hh_since_entry - chandelier_mult * atr)
    else if unrealized_r >= be_r
        candidate := entry_price

    if regime_break
        strategy.close("Long", comment="Regime")
    else
        strategy.exit("Exit", "Long", stop=trail_price, comment="Trail Hit")

    trail_price := math.max(trail_price, candidate)
else
    entry_price  := na
    trail_price  := na
    initial_risk := na
    hh_since_entry := na

risk_usd = strategy.equity * (risk_per_t / 100)
sl_dist  = atr * atr_base_mult
pos_qty  = sl_dist > 0 ? risk_usd / sl_dist : 0

if long_trigger and strategy.position_size == 0 and barstate.isconfirmed
    strategy.entry("Long", strategy.long, qty=pos_qty, comment="Entry")
    strategy.exit("Exit", "Long", stop=close - sl_dist, comment="Trail Hit")

new_exit = strategy.closedtrades > strategy.closedtrades[1]
exit_cmt = strategy.closedtrades > 0 ? strategy.closedtrades.exit_comment(strategy.closedtrades - 1) : ""
trail_hit = new_exit and str.contains(exit_cmt, "Trail")

safe_now  = strategy.position_size > 0 and not na(trail_price) and not na(entry_price) and trail_price > entry_price
bool prev_safe = bar_index > 0 ? safe_now[1] : false
safe_flip = safe_now and not prev_safe

trail_col = safe_now ? color.lime : color.red

plot(ema50, "Fast EMA", color=color.aqua, linewidth=2)
plot(ema200, "Slow EMA", color=color.orange, linewidth=2)
plot(strategy.position_size > 0 ? trail_price : na, "Stepped Trail", color=trail_col, style=plot.style_linebr, linewidth=2)

plotshape(long_trigger and strategy.position_size == 0, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="IN")
plotshape(trail_hit, title="Trail Hit", style=shape.flag, location=location.abovebar, color=color.red, size=size.tiny, text="TRAIL")
plotshape(safe_flip, title="Safe Stop", style=shape.flag, location=location.belowbar, color=color.red, size=size.tiny, text="SAFE")

alertcondition(long_trigger, title="Pullback LONG", message="EMA Pullback Swing v1.2 entry")
alertcondition(trail_hit, title="Trail hit", message="Trail stop hit")
alertcondition(safe_flip, title="Safe stop", message="Trail is now above entry")
