//@version=6
// EMA Pullback Swing v1 — source of truth: strategies/DESIGN.md
// Engine 0.1 must mirror these rules. This is the strategy, not an overlay.
strategy("EMA Pullback Swing v1",
     overlay=true,
     initial_capital=20000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     commission_type=strategy.commission.percent,
     commission_value=0.1)

// ============================================
// INPUTS (v1 defaults are frozen in DESIGN.md)
// ============================================
grp_trend = "Trend & Regime"
fast_len  = input.int(50, "Fast EMA", group=grp_trend)
slow_len  = input.int(200, "Slow EMA", group=grp_trend)

grp_entry     = "Pullback Entry"
rsi_len       = input.int(14, "RSI Length", group=grp_entry)
rsi_dip_look  = input.int(8, "RSI Dip Lookback (bars)", group=grp_entry)
rsi_dip_level = input.int(50, "RSI Must Have Been Below", group=grp_entry)
rsi_band_lo   = input.int(40, "RSI Band Low", group=grp_entry)
rsi_band_hi   = input.int(65, "RSI Band High", group=grp_entry)

grp_risk          = "Adaptive Risk"
atr_len           = input.int(14, "ATR Length", group=grp_risk)
atr_base_mult     = input.float(3.5, "Base ATR Stop Mult", group=grp_risk, step=0.1)
trail_tight_mult  = input.float(2.0, "Tight ATR Stop Mult (R>=threshold)", group=grp_risk, step=0.1)
profit_threshold  = input.float(1.5, "R-Multiple to Tighten", group=grp_risk, step=0.1)
risk_per_t        = input.float(1.5, "Risk % Per Trade", group=grp_risk)

// ============================================
// INDICATORS
// ============================================
ema50  = ta.ema(close, fast_len)
ema200 = ta.ema(close, slow_len)
atr    = ta.atr(atr_len)
rsi    = ta.rsi(close, rsi_len)

bull_regime  = ema50 > ema200
regime_break = ta.crossunder(ema50, ema200)

rsi_had_dip = ta.lowest(rsi, rsi_dip_look) < rsi_dip_level
rsi_in_band = rsi >= rsi_band_lo and rsi <= rsi_band_hi
reclaim     = ta.crossover(close, ema50) and rsi_had_dip and rsi_in_band
// Golden cross is regime only — not an entry (DESIGN v1).
long_trigger = bull_regime and reclaim

// ============================================
// LAGGED TRAIL (stop live this bar is from prior close / initial)
// ============================================
var float entry_price  = na
var float trail_price  = na
var float initial_risk = na

if strategy.position_size > 0
    if na(entry_price)
        entry_price  := strategy.position_avg_price
        initial_risk := atr * atr_base_mult
        trail_price  := entry_price - initial_risk

    unrealized_r = (close - entry_price) / (initial_risk > 0 ? initial_risk : 1.0)
    active_mult  = unrealized_r >= profit_threshold ? trail_tight_mult : atr_base_mult
    candidate    = close - (atr * active_mult)

    if regime_break
        strategy.close("Long", comment="Regime")
    else
        strategy.exit("Exit", "Long", stop=trail_price, comment="Trail Hit")

    // Ratchet for the *next* bar — do not let this bar's low hit this close's trail.
    trail_price := math.max(trail_price, candidate)
else
    entry_price  := na
    trail_price  := na
    initial_risk := na

// ============================================
// SIZE + ENTRY
// ============================================
risk_usd = strategy.equity * (risk_per_t / 100)
sl_dist  = atr * atr_base_mult
pos_qty  = sl_dist > 0 ? risk_usd / sl_dist : 0

if long_trigger and strategy.position_size == 0 and barstate.isconfirmed
    strategy.entry("Long", strategy.long, qty=pos_qty, comment="Entry")
    strategy.exit("Exit", "Long", stop=close - sl_dist, comment="Trail Hit")

// ============================================
// FLAGS: TRAIL hit, SAFE stop (trail > entry)
// ============================================
new_exit = strategy.closedtrades > strategy.closedtrades[1]
exit_cmt = strategy.closedtrades > 0 ? strategy.closedtrades.exit_comment(strategy.closedtrades - 1) : ""
trail_hit = new_exit and str.contains(exit_cmt, "Trail")

safe_now  = strategy.position_size > 0 and not na(trail_price) and not na(entry_price) and trail_price > entry_price
safe_flip = safe_now and (na(safe_now[1]) or not safe_now[1])

trail_col = safe_now ? color.lime : color.red

plot(ema50, "Fast EMA", color=color.aqua, linewidth=2)
plot(ema200, "Slow EMA", color=color.orange, linewidth=2)
plot(strategy.position_size > 0 ? trail_price : na, "Adaptive Trail Stop", color=trail_col, style=plot.style_linebr, linewidth=2)

plotshape(long_trigger and strategy.position_size == 0, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="IN")
plotshape(trail_hit, title="Trail Hit", style=shape.flag, location=location.abovebar, color=color.red, size=size.tiny, text="TRAIL")
plotshape(safe_flip, title="Safe Stop", style=shape.flag, location=location.belowbar, color=color.red, size=size.tiny, text="SAFE")

alertcondition(long_trigger, title="Pullback LONG", message="EMA Pullback Swing v1 entry")
alertcondition(trail_hit, title="Trail hit", message="Trail stop hit")
alertcondition(safe_flip, title="Safe stop", message="Trail is now above entry")
