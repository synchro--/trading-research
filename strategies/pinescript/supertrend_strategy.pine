//@version=6
// Supertrend strategy with costs and a long-only mode so TradingView results
// are comparable to the Python engine (backtesting/strategies/supertrend.py).
strategy("Supertrend Strategy (v6)",
     overlay=true,
     initial_capital=20000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=15,
     pyramiding=0,
     process_orders_on_close=true,
     commission_type=strategy.commission.percent,
     commission_value=0.1)

atrPeriod = input.int(10, "ATR Length")
factor    = input.float(3.0, "Factor", step=0.01)
longOnly  = input.bool(true, "Long only (match engine)")

[st, direction] = ta.supertrend(factor, atrPeriod)

// direction flips to -1 = uptrend begins; +1 = downtrend begins
goLong  = ta.change(direction) < 0
goDown  = ta.change(direction) > 0

if goLong and barstate.isconfirmed
    strategy.entry("Long", strategy.long)

if goDown and barstate.isconfirmed
    if longOnly
        strategy.close("Long", comment="ST flip")
    else
        strategy.entry("Short", strategy.short)

plot(st, "Supertrend", color=direction < 0 ? color.green : color.red, style=plot.style_linebr, linewidth=2)
alertcondition(goLong, "Supertrend long", "Supertrend flipped up")
alertcondition(goDown, "Supertrend down", "Supertrend flipped down")
