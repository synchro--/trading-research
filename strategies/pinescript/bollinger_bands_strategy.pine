//@version=5
strategy("Bollinger Bands Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ============================================
// INPUT PARAMETERS
// ============================================
bb_length = input.int(20, title="Bollinger Bands Length", minval=1)
bb_mult = input.float(2.0, title="Bollinger Bands Multiplier", minval=0.1, maxval=5.0, step=0.1)
stop_loss_pct = input.float(2.0, title="Stop Loss %", minval=0.1, maxval=10.0, step=0.1)
take_profit_pct = input.float(3.0, title="Take Profit %", minval=0.1, maxval=20.0, step=0.1)
use_volume_filter = input.bool(true, title="Use Volume Filter")
volume_ma_length = input.int(20, title="Volume MA Length", minval=1)

// ============================================
// CALCULATIONS
// ============================================
[bb_upper, bb_middle, bb_lower] = ta.bb(close, bb_length, bb_mult)

// Volume filter
volume_ma = ta.sma(volume, volume_ma_length)
volume_above_avg = volume > volume_ma

// Band width for volatility measurement
bb_width = (bb_upper - bb_lower) / bb_middle
bb_width_ma = ta.sma(bb_width, 20)
high_volatility = bb_width > bb_width_ma

// Price position relative to bands
price_near_upper = close >= bb_upper * 0.99  // Within 1% of upper band
price_near_lower = close <= bb_lower * 1.01   // Within 1% of lower band
price_at_middle = close >= bb_middle * 0.995 and close <= bb_middle * 1.005

// Squeeze indicator: Low volatility (bands are close together)
squeeze = bb_width < bb_width_ma * 0.8

// ============================================
// ENTRY CONDITIONS
// ============================================
// Long: Price touches lower band and bounces up (mean reversion)
// With confirmation: price crosses back above lower band
long_condition = ta.crossover(close, bb_lower) and 
                 close < bb_middle and
                 (not use_volume_filter or volume_above_avg)

// Alternative: Bounce from lower band with confirmation
long_condition_alt = close <= bb_lower and 
                     ta.crossover(close, ta.lowest(close, 5)) and
                     close > bb_lower[1] and
                     (not use_volume_filter or volume_above_avg)

// Short: Price touches upper band and bounces down (mean reversion)
// With confirmation: price crosses back below upper band
short_condition = ta.crossunder(close, bb_upper) and 
                  close > bb_middle and
                  (not use_volume_filter or volume_above_avg)

// Alternative: Bounce from upper band with confirmation
short_condition_alt = close >= bb_upper and 
                      ta.crossunder(close, ta.highest(close, 5)) and
                      close < bb_upper[1] and
                      (not use_volume_filter or volume_above_avg)

// Final entry signals
long_entry = long_condition or long_condition_alt
short_entry = short_condition or short_condition_alt

// ============================================
// EXIT CONDITIONS
// ============================================
// Exit long when price reaches middle band or upper band
long_exit_condition = close >= bb_middle or close >= bb_upper

// Exit short when price reaches middle band or lower band
short_exit_condition = close <= bb_middle or close <= bb_lower

// ============================================
// STRATEGY LOGIC
// ============================================
if (long_entry)
    stop_loss_price = close * (1 - stop_loss_pct / 100)
    take_profit_price = close * (1 + take_profit_pct / 100)
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=stop_loss_price, limit=take_profit_price)

if (short_entry)
    stop_loss_price = close * (1 + stop_loss_pct / 100)
    take_profit_price = close * (1 - take_profit_pct / 100)
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=stop_loss_price, limit=take_profit_price)

// Optional: Exit on mean reversion to middle band
if (strategy.position_size > 0 and long_exit_condition and not long_entry)
    strategy.close("Long", comment="BB Middle")

if (strategy.position_size < 0 and short_exit_condition and not short_entry)
    strategy.close("Short", comment="BB Middle")

// ============================================
// PLOTTING
// ============================================
plot(bb_upper, "Upper Band", color=color.red, linewidth=2)
plot(bb_middle, "Middle Band (SMA)", color=color.blue, linewidth=1, linestyle=line.style_dashed)
plot(bb_lower, "Lower Band", color=color.green, linewidth=2)

// Fill between bands
fill(plot(bb_upper), plot(bb_lower), color=color.new(color.blue, 95), title="BB Fill")

// ============================================
// VISIBLE ENTRY SIGNALS - LARGE AND PROMINENT
// ============================================
// Large green arrow for LONG entry
plotshape(long_entry, style=shape.arrowup, location=location.belowbar, 
          color=color.new(color.green, 0), size=size.large, title="🟢 LONG ENTRY SIGNAL")
          
// Large red arrow for SHORT entry
plotshape(short_entry, style=shape.arrowdown, location=location.abovebar, 
          color=color.new(color.red, 0), size=size.large, title="🔴 SHORT ENTRY SIGNAL")

// Text labels with entry information
if (long_entry)
    label.new(bar_index, low, "🟢 BUY\nEntry: " + str.tostring(close, "#.##") + 
              "\nBB Lower: " + str.tostring(bb_lower, "#.##") + 
              "\nSL: " + str.tostring(close * (1 - stop_loss_pct / 100), "#.##") + 
              "\nTP: " + str.tostring(close * (1 + take_profit_pct / 100), "#.##"),
              style=label.style_label_up, color=color.green, textcolor=color.white, 
              size=size.normal, yloc=yloc.belowbar)

if (short_entry)
    label.new(bar_index, high, "🔴 SELL\nEntry: " + str.tostring(close, "#.##") + 
              "\nBB Upper: " + str.tostring(bb_upper, "#.##") + 
              "\nSL: " + str.tostring(close * (1 + stop_loss_pct / 100), "#.##") + 
              "\nTP: " + str.tostring(close * (1 - take_profit_pct / 100), "#.##"),
              style=label.style_label_down, color=color.red, textcolor=color.white, 
              size=size.normal, yloc=yloc.abovebar)

// Background highlight when signal triggers
bgcolor(long_entry ? color.new(color.green, 80) : short_entry ? color.new(color.red, 80) : na, 
        title="Signal Background")

// Plot squeeze indicator (informational)
plotshape(squeeze, style=shape.diamond, location=location.top, 
          color=color.orange, size=size.small, title="Squeeze")

// Background color for high volatility
bgcolor(high_volatility ? color.new(color.yellow, 97) : na, title="High Volatility")

// ============================================
// ALERT CONDITIONS
// ============================================
alertcondition(long_entry, title="🟢 Bollinger Bands LONG Signal", 
               message="🟢 BOLLINGER BANDS LONG ENTRY SIGNAL! Price: {{close}}, Entry: {{close}}, Lower Band: " + 
               str.tostring(bb_lower, "#.##") + ", Stop Loss: " + 
               str.tostring(close * (1 - stop_loss_pct / 100), "#.##") + ", Take Profit: " + 
               str.tostring(close * (1 + take_profit_pct / 100), "#.##"))

alertcondition(short_entry, title="🔴 Bollinger Bands SHORT Signal", 
               message="🔴 BOLLINGER BANDS SHORT ENTRY SIGNAL! Price: {{close}}, Entry: {{close}}, Upper Band: " + 
               str.tostring(bb_upper, "#.##") + ", Stop Loss: " + 
               str.tostring(close * (1 + stop_loss_pct / 100), "#.##") + ", Take Profit: " + 
               str.tostring(close * (1 - take_profit_pct / 100), "#.##"))

