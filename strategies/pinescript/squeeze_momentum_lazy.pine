//@version=6
// Squeeze Momentum Indicator [LazyBear], converted from the original v1 script.
// Original: https://www.tradingview.com/v/4IneGo8h/
// NOTE: the original uses multKC for the BB deviation (well-known quirk).
// Kept as-is for fidelity — the community results are based on this exact code.
indicator("Squeeze Momentum [LazyBear] (v6)", shorttitle="SQZMOM_LB", overlay=false)

length       = input.int(20, "BB Length")
mult         = input.float(2.0, "BB MultFactor")
lengthKC     = input.int(20, "KC Length")
multKC       = input.float(1.5, "KC MultFactor")
useTrueRange = input.bool(true, "Use TrueRange (KC)")

// Bollinger Bands (original uses multKC here, not mult)
basis   = ta.sma(close, length)
dev     = multKC * ta.stdev(close, length)
upperBB = basis + dev
lowerBB = basis - dev

// Keltner Channels
ma      = ta.sma(close, lengthKC)
kcRange = useTrueRange ? ta.tr : high - low
rangema = ta.sma(kcRange, lengthKC)
upperKC = ma + rangema * multKC
lowerKC = ma - rangema * multKC

sqzOn  = lowerBB > lowerKC and upperBB < upperKC
sqzOff = lowerBB < lowerKC and upperBB > upperKC
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(close - math.avg(math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC)), ta.sma(close, lengthKC)), lengthKC, 0)

bcolor = val > 0 ? (val > nz(val[1]) ? color.lime : color.green) : (val < nz(val[1]) ? color.red : color.maroon)
scolor = noSqz ? color.blue : sqzOn ? color.black : color.gray

plot(val, "Momentum", color=bcolor, style=plot.style_histogram, linewidth=4)
plot(0, "Squeeze State", color=scolor, style=plot.style_cross, linewidth=2)

// Release bar: squeeze was on, now off, momentum positive (the tradeable event)
release_long = sqzOn[1] and not sqzOn and val > 0
plotshape(release_long, "Squeeze Release Long", style=shape.triangleup, location=location.bottom, color=color.lime, size=size.tiny)
alertcondition(release_long, "Squeeze release long", "SQZMOM: squeeze released with positive momentum")
